{
  "name": "app.xvi.reader",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "阅读 — 书籍、摘录、OCR 与 AI 讨论",
  "main": "index.ts",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "op-sqlite": {
    "fts5": true
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "install:android": "node scripts/install-android.mjs",
    "build": "pnpm build:web && expo export --platform android --output-dir dist/android",
    "build:web": "node scripts/build-reader-web.mjs",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "lint:web": "eslint web --max-warnings=0",
    "test:web": "playwright test -c web/playwright.config.ts",
    "test:lan-native": "node scripts/test-reader-lan-native.mjs",
    "build:android-apk": "node scripts/build-android-apk.mjs",
    "build:android-apk:arm64": "node scripts/build-android-apk.mjs --arch=arm64-v8a",
    "build:android-apk:emulator": "node scripts/build-android-apk.mjs --arch=x86_64",
    "check:android-native": "node scripts/check-android-native.mjs",
    "check:independence": "node scripts/check-independence.mjs",
    "lint": "eslint app src tests --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm check:independence && pnpm lint && pnpm lint:web && pnpm typecheck && pnpm typecheck:web && pnpm test && pnpm test:web && pnpm build"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.7",
    "@noble/hashes": "2.0.1",
    "@op-engineering/op-sqlite": "17.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "eventsource-parser": "3.0.6",
    "expo": "~57.0.8",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.7",
    "expo-file-system": "~57.0.6",
    "expo-image-manipulator": "~57.0.10",
    "expo-image-picker": "~57.0.10",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-secure-store": "57.0.1",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "fflate": "^0.8.3",
    "katex": "0.16.33",
    "lucide-react-native": "1.26.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "10.1.0",
    "react-native": "0.86.2",
    "react-native-enriched-markdown": "0.7.4",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "^24.10.0",
    "@types/react": "~19.2.2",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.0",
    "typescript": "~6.0.3",
    "vite": "7.3.5",
    "vitest": "^4.1.10"
  }
}
